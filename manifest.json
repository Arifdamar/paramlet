{
  "manifest_version": 3,
  "name": "Paramlet",
  "version": "0.1.0",
  "description": "See and edit a page's query parameters from the address bar.",
  "icons": {
    "48": "icons/paramlet.svg",
    "96": "icons/paramlet.svg"
  },
  "permissions": ["tabs"],
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "page_action": {
    "default_icon": "icons/paramlet.svg",
    "default_title": "Query parameters",
    "default_popup": "src/popup/popup.html"
  },
  "commands": {
    "_execute_page_action": {
      "suggested_key": { "default": "Alt+Q", "mac": "MacCtrl+Q" },
      "description": "Open the parameter panel"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "paramlet@arifdamar.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
