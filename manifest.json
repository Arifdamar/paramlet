{
  "manifest_version": 3,
  "name": "Paramlet",
  "version": "1.1.2",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/Arifdamar/paramlet",
  "icons": {
    "48": "icons/paramlet.svg",
    "96": "icons/paramlet.svg"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "page_action": {
    "default_icon": "icons/paramlet.svg",
    "default_title": "Paramlet",
    "default_popup": "src/popup/popup.html",
    "show_matches": [
      "http://*/*",
      "https://*/*"
    ]
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_page_action": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "MacCtrl+Q"
      },
      "description": "__MSG_commandDescription__"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "paramlet@arifdamar.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
